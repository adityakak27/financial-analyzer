# Copy to .env and fill in what you have. Never put a real key in THIS file -- it is committed to git.
# The chat assistant needs GEMINI_API_KEY. Without it, the dashboards, Mispricing Radar and the
# analysis study still work, and AI analyst notes fall back to deterministic templates.

# Google Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# SEC EDGAR requires a declared user agent; put your real contact email
SEC_USER_AGENT=FinChat Research research@example.com

# Optional: path to Loughran-McDonald dictionary CSV for full-lexicon sentiment.
# Without it, a compact built-in fallback lexicon is used.
LM_LEXICON_PATH=data/lm_lexicon.csv
