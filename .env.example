# Copy to .env and fill in what you have. Everything is optional:
# without an LLM key the chatbot runs in deterministic offline mode
# (tool lookups + extractive retrieval answers, no generation).

# OpenAI-compatible API (used for intent routing, tool-calling, answer synthesis)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FINCHAT_MODEL=gpt-4o-mini

# SEC EDGAR requires a declared user agent; put your real contact email
SEC_USER_AGENT=FinChat Research research@example.com

# Optional: path to Loughran-McDonald dictionary CSV for full-lexicon sentiment.
# Without it, a compact built-in fallback lexicon is used.
LM_LEXICON_PATH=data/lm_lexicon.csv
